# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่เข้า Git)
# docker compose อ่านไฟล์นี้เอง และ backend อ่าน DATABASE_URL ตัวเดียวกัน

POSTGRES_USER=inspector
POSTGRES_PASSWORD=inspector
POSTGRES_DB=inspector
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://inspector:inspector@127.0.0.1:5432/inspector

# ที่เก็บภาพ snapshot ของชิ้นงานที่ตรวจพบว่าบกพร่อง
# เก็บเป็นไฟล์บนไดรฟ์ D: ไม่เก็บลงตาราง เพราะไฟล์ภาพโตเร็วกว่าตัวข้อมูลมาก
SNAPSHOT_DIR=D:/project/inspector/data/snapshots
